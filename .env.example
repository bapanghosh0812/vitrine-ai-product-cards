# Vitrine environment variables. Copy to .env.local for local development (gitignored).
# Never commit real values. On Vercel / Netlify set these in the project settings.

# ---- Server only (never shipped to the browser) ---------------------------------
# AI providers (free tiers). Groq is primary, Gemini is the automatic fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
# Model IDs are configurable; verify current free models with the providers' /models APIs.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.1-flash-lite
# Firebase project id, used to verify ID tokens (public signing keys, no service account)
FIREBASE_PROJECT_ID=
# Extra origins allowed to call the API (comma separated). Same-host requests are always allowed.
ALLOWED_ORIGINS=https://vitrine-ai-product-cards.vercel.app,https://vitrine-ai-product-cards.netlify.app,https://bapanghosh0812.github.io
# Time budget for one AI request in ms (keep under the host's function timeout)
AI_BUDGET_MS=9000
# 1 = deterministic offline mock AI (tests, demos without keys)
AI_MOCK=
# Owner account that receives the admin claim (scripts/set-admin-claim.mjs)
OWNER_EMAIL=
# Support mailer: Gmail address + app password (https://myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
# Inbox that receives support tickets (defaults to SMTP_USER)
SUPPORT_INBOX=
# Public site URL used for links and the logo in emails
SITE_URL=https://vitrine-ai-product-cards.vercel.app
# 1 = log emails instead of sending (tests)
MAIL_MOCK=

# ---- Public build-time values (compiled into the browser bundle) ------------------
# The Firebase web config is public by design; access is enforced by firestore.rules.
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_STORAGE_BUCKET=
NG_APP_FIREBASE_MESSAGING_SENDER_ID=
NG_APP_FIREBASE_APP_ID=
# Empty = same origin. GitHub Pages builds point this at the Vercel deployment.
NG_APP_API_BASE=
NG_APP_SITE_URL=https://vitrine-ai-product-cards.vercel.app
NG_APP_REPO_URL=https://github.com/bapanghosh0812/vitrine-ai-product-cards
# Shown in the legal pages as the grievance contact (falls back to GitHub Issues)
NG_APP_SUPPORT_EMAIL=
