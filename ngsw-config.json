{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.csr.html", "/favicon.ico", "/favicon.svg", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "pages",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/offline/index.html", "/help/**/index.html", "/legal/**/index.html", "/templates/index.html"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/brand/**", "/emoji/**", "/icons/**", "/media/**", "/*.(svg|png|webp|woff2)"]
      }
    }
  ]
}
