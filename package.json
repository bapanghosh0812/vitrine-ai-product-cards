{
  "name": "vitrine-ai-product-cards",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "ng serve",
    "dev:api": "tsx watch server/dev.ts",
    "content": "node scripts/build-content.mjs",
    "env": "node scripts/gen-env.mjs",
    "prebuild": "npm run content && npm run env",
    "build": "ng build",
    "build:vercel": "npm run build && node scripts/postbuild.mjs --target vercel && node scripts/build-api.mjs --target vercel",
    "build:netlify": "npm run build && node scripts/postbuild.mjs --target netlify",
    "build:pages": "npm run content && npm run env && ng build --base-href /vitrine-ai-product-cards/ && node scripts/postbuild.mjs --target pages",
    "serve:dist": "tsx scripts/serve-dist.ts",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "ng test --watch=false",
    "test:api": "vitest run --config vitest.server.config.ts",
    "test:all": "npm run test && npm run test:api",
    "e2e": "playwright test",
    "secrets:scan": "secretlint \"**/*\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prepare": "simple-git-hooks || exit 0",
    "test:rules": "firebase emulators:exec --only firestore --project demo-vitrine \"npx vitest run --config vitest.rules.config.ts\"",
    "e2e:local": "playwright test --project=chromium --project=mobile-chrome",
    "security:audit": "tsx scripts/security-audit.ts",
    "og": "tsx scripts/render-og.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "docs": "tsx scripts/build-docs.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/groq": "^4.0.84",
    "@angular/cdk": "~22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "~22.2.6",
    "@angular/ssr": "^22.2.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "ai": "^7.0.173",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "hono": "^4.13.19",
    "html-to-image": "^1.11.13",
    "lucide": "^1.74.0",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "secretlint": "^14.0.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "description": "Vitrine: AI product-card generator (Angular 22 + Hono API). Products, beautifully told.",
  "author": "Bapan Ghosh",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx secretlint --maskSecrets $(git diff --cached --name-only --diff-filter=ACM) || exit 1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
